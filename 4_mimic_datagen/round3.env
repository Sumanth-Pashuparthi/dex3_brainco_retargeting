# Environment for the targeted (round 3) generation. Source before the run_* scripts:
#
#   source ./round3.env
#   python3 plan_targeted.py --total 1000 --out "$EVAL_DIR/round3_plan.json"
#   ./run_generate_targeted.sh "$EVAL_DIR/round3_plan.json" 2 "0 1 2"
#   ./run_merge_targeted.sh
#
# This file exists to put round 3's bulk data somewhere other than the checkout, because round 3 is
# ~126 GB of HDF5 at round 2's 0.126 GB/demo and that will not fit on a typical root filesystem.
# arena_run.sh mounts the parent of DATA_DIR as /datasets and the parent of EVAL_DIR as /eval, so
# pointing these three at a big disk is the whole change -- nothing in the container moves.
#
# Set BULK_DIR to the big disk before sourcing, e.g.
#
#   BULK_DIR=/mnt/raid/apple_r3 source ./round3.env
#
# It defaults to $WORK_DIR/round3, which keeps everything self-contained but needs the space.
# ARENA_DIR, GR00T_DIR and MODELS_DIR are inherited from env.sh; export them yourself first if the
# checkouts are not under $WORK_DIR.

WORK_DIR=${WORK_DIR:-$HOME/g1_baseline}
BULK_DIR=${BULK_DIR:-$WORK_DIR/round3}

export DATA_DIR=${DATA_DIR:-$BULK_DIR/datasets/g1_apple_mimic}
export EVAL_DIR=${EVAL_DIR:-$BULK_DIR/eval/g1_apple_mimic}
export LOG_DIR=${LOG_DIR:-$BULK_DIR/logs/g1_apple_mimic}

mkdir -p "$DATA_DIR" "$EVAL_DIR" "$LOG_DIR"

# Two things have to be staged in $DATA_DIR before generating: source_annotated.hdf5 (the
# generation input) and round 2's LeRobot tree, which run_merge_targeted.sh merges the new round
# into. Round 2's raw HDF5 is deliberately not needed -- the LeRobot form is all the merge and the
# training consume.
#
# plan_targeted.py reads the round-2 eval outcomes from $EVAL_DIR. If they live elsewhere, set
# PREV_EVAL_DIR and they are copied across on first use.
if [ -n "${PREV_EVAL_DIR:-}" ]; then
  for f in eval100_spawn_xy.npy eval100_success.npy lerobot_ep_spawn.npy lerobot_to_demo.json; do
    [ -f "$EVAL_DIR/$f" ] || cp "$PREV_EVAL_DIR/$f" "$EVAL_DIR/$f" 2>/dev/null
  done
fi
